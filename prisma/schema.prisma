datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  COORDENADOR
  AUXILIAR
}

enum Semester {
  ALL
  SEMESTER1
  SEMESTER2
  SEMESTER3
  SEMESTER4
  SEMESTER5
  SEMESTER6
  ESPECIAL
}

enum AuthCodePurpose {
  TWO_FACTOR
  PASSWORD_RESET
}

enum AuditOutcome {
  SUCCESS
  ERROR
  DENIED
}

model User {
  id             Int            @id @default(autoincrement())
  imageUrl       String?        @db.VarChar(2048)
  name           String         @db.VarChar(120)
  email          String         @unique @db.VarChar(191)
  password       String         @db.VarChar(255)
  role           Role
  // Goes into every session token: raising it (password or role change) ends all open sessions at once.
  sessionVersion Int            @default(0)
  refreshToken   RefreshToken[]
  authCodes      AuthCode[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([role])
  @@index([createdAt])
}

// 2FA and password reset codes live in the database so a code stays single-use even after an API restart.
// A reset asked for an unknown e-mail also gets a row (without user), so both cases answer exactly alike.
model AuthCode {
  id        String          @id @db.Char(36)
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int?
  purpose   AuthCodePurpose
  codeHash  String          @db.Char(64)
  failures  Int             @default(0)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime        @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

// The actor is copied instead of related: the history must stay intact when a user is renamed or removed.
model AuditLog {
  id           Int          @id @default(autoincrement())
  createdAt    DateTime     @default(now())
  actorId      Int?
  actorName    String?      @db.VarChar(120)
  actorEmail   String?      @db.VarChar(191)
  actorRole    Role?
  action       String       @db.VarChar(40)
  resource     String       @db.VarChar(40)
  summary      String       @db.VarChar(255)
  targetId     String?      @db.VarChar(64)
  targetLabel  String?      @db.VarChar(255)
  outcome      AuditOutcome
  statusCode   Int
  method       String       @db.VarChar(10)
  path         String       @db.VarChar(255)
  ip           String?      @db.VarChar(64)
  userAgent    String?      @db.VarChar(255)
  errorMessage String?      @db.VarChar(500)
  before       Json?
  after        Json?
  changes      Json?
  requestBody  Json?
  response     Json?
  details      Json?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([resource, createdAt])
  @@index([outcome, createdAt])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  tokenHash String   @unique @db.Char(64)
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Course {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(80)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  eventCourses EventCourse[]
  Participant  Participant[]

  @@index([createdAt])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(80)
  Event     Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Location {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(80)
  Event     Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Carousel {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(80)
  imageUrl  String   @db.VarChar(2048)
  isActive  Boolean  @default(false)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([order])
  @@index([isActive])
}

model Event {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(140)
  description         String    @db.Text
  imageUrl            String    @db.VarChar(2048)
  eventCourses        EventCourse[]
  semester            Semester?
  maxParticipants     Int
  currentParticipants Int       @default(0)
  isRestricted        Boolean
  locationId          Int
  location            Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customLocation      String?   @db.VarChar(140)

  speakerName    String        @db.VarChar(120)
  startDate      DateTime
  endDate        DateTime?
  startTime      DateTime
  endTime        DateTime
  duration       Int?
  presenceSecret String?       @db.VarChar(80)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  categoryId     Int?
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  participants   Participant[]
  Certificate    Certificate[]

  @@index([categoryId])
  @@index([locationId])
  @@index([isRestricted])
  @@index([semester, startDate])
  @@index([endDate])
  @@fulltext([name, description])
}

model EventCourse {
  eventId   Int
  courseId  Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([eventId, courseId])
  @@index([courseId])
}

model Participant {
  id              Int           @id @default(autoincrement())
  name            String        @db.VarChar(120)
  email           String        @db.VarChar(191)
  courseId        Int?
  course          Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  semester        Semester?
  ra              String?       @db.VarChar(32)
  isPresent       Boolean       @default(false)
  certificateSent Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  eventId         Int
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  Certificate     Certificate[]

  @@unique([eventId, email])
  @@index([email])
  @@index([eventId, isPresent])
  @@index([createdAt])
}

model Certificate {
  id            Int         @id @default(autoincrement())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId Int
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       Int
  tokenHash     String      @unique @db.Char(64)
  issuedAt      DateTime    @default(now())

  @@unique([participantId, eventId])
  @@index([eventId])
}
